  "gathered_in": "kkt-settings",
  "users": {
   "kkt-rules": [
    "kkt-rules::Settings"
   ],
   "kkt-mcp": [
    "kkt-rules::Settings"
   ],
   "kkt-container": [
    "kkt-rules::Settings"
   ],
   "kkt-server": [
    "kkt-rules::Settings",
    "kkt-format::Settings",
    "kkt-web::Settings",
    "kkt-admission::Settings"
   ],
   "kkt-web": [
    "kkt-web::Settings"
   ],
   "kkt-identity": [
    "kkt-rules::Settings"
   ],
   "kkt-provenance": [
    "kkt-settings::Limits"
   ],
   "kkt-settings": [
    "kkt-settings::Limits"
   ],
   "kashkeshet": [
    "kkt-settings::Limits"
   ],
   "kkt-fake-product": [
    "kkt-settings::Limits"
   ]
  },
  "note": "Limits becomes what kkt-settings gathers from flags, the config file and defaults; its fields split into per-crate settings structs, each checked by its own crate, which the program fills (names to be chosen in the refactor). upgrade_backups_kept stays with what kkt-settings gathers: kkt-backup's prune already takes the count as an argument, which the program passes",
  "parts": [
   {
    "crate": "kkt-rules",
    "path": "Settings",
    "kind": "struct",
    "doc": "kkt-rules' share of today's Limits: name_pack, default_limit, max_limit, max_body_bytes, the name, purpose, description, note, announcement, memory and lane lengths, sends_per_minute, registrations_per_minute, max_agents, default_wait, max_wait, waiting_grace, member_preview and purpose_preview_chars (item 7)."
   },
   {
    "crate": "kkt-format",
    "path": "Settings",
    "kind": "struct",
    "doc": "kkt-format's share of today's Limits: max_response_bytes (item 7)."
   },
   {
    "crate": "kkt-web",
    "path": "Settings",
    "kind": "struct",
    "doc": "kkt-web's share of today's Limits: web_page_messages and web_member_excerpt_chars, and the lengths its forms check (channel name, purpose, description), which the program fills from kkt-rules' since kkt-web must not depend on kkt-rules (item 7)."
   },
   {
    "crate": "kkt-admission",
    "path": "Settings",
    "kind": "struct",
    "doc": "kkt-admission's share of today's Limits: web_session_lifetime (item 7)."
   }
  ]
 }
