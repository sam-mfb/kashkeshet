[
  {
    "description": "Which channels, closed and hidden ones included, have messages newer than `after_id`, and how many, with the latest message ID. A cheap way to see what changed.",
    "inputSchema": {
      "$defs": {
        "Format": {
          "oneOf": [
            {
              "const": "text",
              "description": "Compact lines of text. The default.",
              "type": "string"
            },
            {
              "const": "json",
              "description": "A JSON object.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "after_id": {
          "description": "The highest message ID you have seen. Use 0 to count everything.",
          "format": "int64",
          "type": "integer"
        },
        "format": {
          "anyOf": [
            {
              "$ref": "#/$defs/Format"
            },
            {
              "type": "null"
            }
          ],
          "description": "`text` (default) or `json`."
        }
      },
      "required": [
        "after_id"
      ],
      "type": "object"
    },
    "name": "activity"
  },
