      "properties": {
        "after_id": {
          "description": "The highest message ID you have seen.",
          "format": "int64",
          "type": "integer"
        },
        "channel_ids": {
          "description": "Only these channels. Default: every channel.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
