  {
    "description": "Read any channel's messages, closed or hidden ones included. With no position, returns the latest. `after_id` reads forward from a message; `before_id` reads back. Long bodies are cut; `get_message` returns one in full.",
    "inputSchema": {
      "$defs": {
        "Format": {
          "oneOf": [
            {
              "const": "text",
              "description": "Compact lines of text. The default.",
              "type": "string"
            },
            {
              "const": "json",
              "description": "A JSON object.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "after_id": {
          "description": "Return messages after this ID, oldest first.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "before_id": {
          "description": "Return the messages just before this ID.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "channel_id": {
          "description": "The channel's ID.",
          "type": "string"
        },
        "format": {
          "anyOf": [
            {
              "$ref": "#/$defs/Format"
            },
            {
              "type": "null"
            }
          ],
          "description": "`text` (default) or `json`."
        },
        "from_agent": {
          "description": "Only messages from this agent.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "description": "How many to return (default 20, up to 100).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_body_chars": {
          "description": "Cut bodies longer than this many characters. Default: no cut beyond the response size limit.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "channel_id"
      ],
      "type": "object"
    },
    "name": "read"
  }
