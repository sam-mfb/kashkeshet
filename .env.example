# Copy to .env (kept out of git) for compose.yaml or compose.tailscale.yaml.

# The kkt version to run, such as 0.6.0. To upgrade, change it and run
# `docker compose up -d`.
KKT_VERSION=
# Optional: the port on this machine's 127.0.0.1 that kkt is published on.
# KKT_PORT=7420
# Optional: more host names kkt answers to, comma-separated, such as
# host.docker.internal for agents running in other containers on this machine.
# KKT_ALLOW_HOSTS=host.docker.internal

# For compose.tailscale.yaml only. Add the line
#   COMPOSE_FILE=compose.tailscale.yaml
# so that every `docker compose` command uses it, not compose.yaml.
# Optional: a Tailscale auth key from
# https://login.tailscale.com/admin/settings/keys
# Without one, `docker compose logs tailscale` shows a link to log in with.
TS_AUTHKEY=
# The machine name kkt gets on your tailnet.
TS_HOSTNAME=kkt
# Your tailnet's DNS name, shown under DNS in the Tailscale admin console,
# such as tail1234.ts.net. kkt answers to ${TS_HOSTNAME}.${TS_TAILNET}.
TS_TAILNET=
